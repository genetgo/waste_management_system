-- ==========================================
-- Migration 001: Core User & Staff Tables
-- ==========================================

-- 1. System Administrators
CREATE TABLE IF NOT EXISTS system_administrators (
    admin_id SERIAL PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    username VARCHAR(50) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. Municipal Administrators
CREATE TABLE IF NOT EXISTS municipal_administrators (
    admin_id SERIAL PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    phone_number VARCHAR(15) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    assigned_kifle_ketema VARCHAR(100) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 3. Collectors
CREATE TABLE IF NOT EXISTS collectors (
    collector_id SERIAL PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    phone_number VARCHAR(15) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    assigned_kifle_ketema VARCHAR(100) NOT NULL,
    kebele VARCHAR(50) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 4. Residents
CREATE TABLE IF NOT EXISTS residents (
    resident_id SERIAL PRIMARY KEY,
    full_name VARCHAR(50) NOT NULL,
    
    phone_number VARCHAR(15) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    address VARCHAR(150) NOT NULL,
    kebele VARCHAR(50) NOT NULL,
    kifle_ketema VARCHAR(100) NOT NULL,
    profile_image VARCHAR(255),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 5. Business Owners
CREATE TABLE IF NOT EXISTS business_owners (
    business_id SERIAL PRIMARY KEY,
    business_name VARCHAR(100) NOT NULL,
    owner_name VARCHAR(100) NOT NULL,
    phone_number VARCHAR(15) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    address VARCHAR(150) NOT NULL,
    business_type VARCHAR(100) NOT NULL,
    kebele VARCHAR(50) NOT NULL,
    kifle_ketema VARCHAR(100) NOT NULL,
    profile_image VARCHAR(255),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- Migration 002: Schedules & On-Demand Requests
-- ==========================================

-- 1. Collection Schedules (መደበኛ የቆሻሻ ማንሻ ፕሮግራም)
CREATE TABLE IF NOT EXISTS collection_schedules (
    schedule_id SERIAL PRIMARY KEY,
    kifle_ketema VARCHAR(100) NOT NULL,
    kebele VARCHAR(50) NOT NULL,
    collector_id INT,
    collection_date DATE NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL,
    target_group VARCHAR(20) DEFAULT 'All' CHECK(target_group IN ('Resident', 'Business', 'All')),
    status VARCHAR(20) DEFAULT 'Scheduled' CHECK(status IN ('Scheduled', 'In Progress', 'Completed', 'Cancelled')),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(collector_id) REFERENCES collectors(collector_id) ON DELETE SET NULL
);

-- 2. On-Demand Requests (ለንግድ ተቋማት ብቻ - በ Leaflet/Geolocation የሚላክ)
CREATE TABLE IF NOT EXISTS on_demand_requests (
    request_id SERIAL PRIMARY KEY,
    business_id INT NOT NULL,
    collector_id INT,
    approved_by INT,
    collection_address VARCHAR(150) NOT NULL,
    kebele VARCHAR(50) NOT NULL,
    kifle_ketema VARCHAR(100) NOT NULL,
    latitude DECIMAL(10,8) NOT NULL,
    longitude DECIMAL(11,8) NOT NULL,
    preferred_collection_date DATE NOT NULL,
    request_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(20) DEFAULT 'Pending' CHECK(status IN (
        'Pending', 'Approved', 'Assigned', 'Collected', 'Completed', 'Rejected', 'Cancelled'
    )),
    approved_at TIMESTAMP,
    collected_at TIMESTAMP,
    completed_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(business_id) REFERENCES business_owners(business_id) ON DELETE CASCADE,
    FOREIGN KEY(collector_id) REFERENCES collectors(collector_id) ON DELETE SET NULL,
    FOREIGN KEY(approved_by) REFERENCES municipal_administrators(admin_id) ON DELETE SET NULL
);

-- ==========================================
-- Migration 003: Notifications
-- ==========================================

CREATE TABLE IF NOT EXISTS notifications (
    notification_id SERIAL PRIMARY KEY,
    resident_id INT,
    business_id INT,
    collector_id INT,
    admin_id INT,
    sent_by INT NOT NULL,
    message TEXT NOT NULL,
    is_read BOOLEAN DEFAULT FALSE,
    notification_date DATE DEFAULT CURRENT_DATE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(resident_id) REFERENCES residents(resident_id) ON DELETE CASCADE,
    FOREIGN KEY(business_id) REFERENCES business_owners(business_id) ON DELETE CASCADE,
    FOREIGN KEY(collector_id) REFERENCES collectors(collector_id) ON DELETE CASCADE,
    FOREIGN KEY(admin_id) REFERENCES municipal_administrators(admin_id) ON DELETE CASCADE
);

-- ==========================================
-- Migration 004: Performance Indexes
-- ==========================================

CREATE INDEX IF NOT EXISTS idx_resident_location ON residents(kifle_ketema, kebele);
CREATE INDEX IF NOT EXISTS idx_business_location ON business_owners(kifle_ketema, kebele);
CREATE INDEX IF NOT EXISTS idx_request_status ON on_demand_requests(status);
CREATE INDEX IF NOT EXISTS idx_schedule_date ON collection_schedules(collection_date);
CREATE INDEX IF NOT EXISTS idx_notification_read ON notifications(is_read);